# Copy to .env beside your downloaded compose.yaml; fill in a published digest.
ENRAMA_CLI_IMAGE=ghcr.io/dev-peter21/enrama@sha256:REPLACE_WITH_VERIFIED_CLI_DIGEST
# Absolute directory containing only one client, enrama.yaml and assets/.
ENRAMA_SITE=/absolute/path/to/client
# Obtain with id -u and id -g; do not use root (0).
ENRAMA_UID=1000
ENRAMA_GID=1000
ENRAMA_PREVIEW_PORT=8000
